# Settings for your machine. Optional: everything has a default, so you only
# need this to change something. Copy this file to .env first.
# .env is not committed to git. For the live server, see .env.prod.example.

POSTGRES_DB=catalyst
POSTGRES_USER=catalyst
POSTGRES_PASSWORD=catalyst

# Port on this machine for connecting a database client (e.g. DBeaver, pgAdmin).
POSTGRES_PORT=5434
