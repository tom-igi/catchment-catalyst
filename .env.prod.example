# Settings for the live server. On the server, copy this file to .env (in the
# project folder) and fill in the values. Never commit the filled-in copy:
# .env is ignored by git.

# Use the live settings (docker-compose.prod.yml) instead of the development
# ones. Keep this line, so every docker compose command on the server uses
# the live settings.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

POSTGRES_DB=catalyst
POSTGRES_USER=catalyst

# A long random password. Letters and numbers only, because it also goes into
# a web-style address. To make one, run:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Who can log in to the admin page: one entry per person, separated by commas.
# Each entry is their name and a hash of their password (never the password
# itself). To make someone's entry, run this on your own machine, in the
# project folder, and paste what it prints:
#   docker compose run --rm admin hash-password <name>
ADMIN_USERS=

# Signs the admin page's login cookie. A long random value, made with:
#   openssl rand -hex 32
# Changing it logs everyone out.
ADMIN_SECRET_KEY=
